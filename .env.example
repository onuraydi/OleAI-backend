# Database & Caching
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=oleai_db;Username=postgres;Password=YOUR_DB_PASSWORD
Redis__ConnectionString=localhost:6379

# JWT Token Options
TokenOptions__Audience=oleai.com
TokenOptions__Issuer=oleai.com
TokenOptions__AccessTokenExpiration=60
TokenOptions__RefreshTokenTTL=7
TokenOptions__SecurityKey=YOUR_SUPER_SECRET_SECURITY_KEY_MIN_32_CHARS

# External AI & Local LLM Services
AiServiceSettings__BaseUrl=http://localhost:8000
OllamaSettings__BaseUrl=http://localhost:11434
OllamaSettings__ModelName=oleai-editor

# Cloudinary Image Storage
CloudinarySettings__CloudName=YOUR_CLOUD_NAME
CloudinarySettings__ApiKey=YOUR_API_KEY
CloudinarySettings__ApiSecret=YOUR_API_SECRET

# SMTP Mail Settings
MailSettings__Host=smtp.gmail.com
MailSettings__Port=587
MailSettings__SenderFullName=OleAI
MailSettings__SenderEmail=noreply@oleai.com
MailSettings__UserName=YOUR_SMTP_USER
MailSettings__Password=YOUR_SMTP_PASSWORD
