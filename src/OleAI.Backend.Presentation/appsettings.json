{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "OleAIConnectionString": "WillBeInjectedFromEnv",
        "Redis": "WillBeInjectedFromEnv"
    },
    "TokenOptions": {
        "Audience": "",
        "Issuer": "",
        "SecurityKey": "",
        "AccessTokenExpiration": 15,
        "RefreshTokenExpiration": 7,
        "MaxActiveTokens": 5
    },
    "MailSettings": {
        "Server": "",
        "Port": 0,
        "SenderFullName": "",
        "SenderEmail": "",
        "UserName": "",
        "Password": ""
    },
    "SecuritySettings": {
        "DefaultRoleId": "",
        "AdminRoleId": ""
    },
    "OllamaSettings": {
        "BaseUrl": "http://localhost:11434",
        "ModelName": "oleai-editor:latest",
        "SystemPrompt": "Sen kıdemli bir mutfak ve veri tabanı asistanısın. Kullanıcının girdiği malzeme adını analiz edip SADECE JSON formatında yanıt vermelisin. Asla ekstra açıklama yapma. JSON formatı: {\"IsNew\": bool, \"SuggestedAliasFor\": \"string veya null\", \"Category\": \"string\", \"BaseUnitType\": \"string\", \"Reason\": \"string\"}"
    },
    "CloudinarySettings": {
        "CloudName": "",
        "ApiKey": "",
        "ApiSecret": ""
    },
    "AiService": {
        "BaseUrl": "http://localhost:8000",
        "ApiKey": "oleai_shared_secret_key_for_development"
    },
    "Firebase": {
        "CredentialsPath": ""
    }
}
