{
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async", "Serilog.Sinks.MSSqlServer" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.Hosting.Lifetime": "Information",
                "System": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithExceptionDetails" ],
        "WriteTo": [
            {
                "Name": "Async",
                "Args": {
                    "configure": [
                        {
                            "Name": "Console",
                            "Args": {
                                "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
                            }
                        },
                        {
                            "Name": "File",
                            "Args": {
                                "path": "logs/oleai-log-.txt",
                                "rollingInterval": "Day",
                                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] [CorrId: {CorrelationId}] {Message:lj}{NewLine}{Exception}"
                            }
                        },
                        {
                            "Name": "MSSqlServer",
                            "Args": {
                                "connectionString": "OleAIConnectionString",
                                "sinkOptionsSection": {
                                    "tableName": "Logs",
                                    "autoCreateSqlTable": true
                                },
                                "columnOptionsSection": {
                                    "customColumns": [
                                        {
                                            "ColumnName": "CorrelationId",
                                            "DataType": "nvarchar",
                                            "DataLength": 50
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                }
            }
        ]
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "OleAIConnectionString": "",
        "Redis": "localhost:6379"
    },
    "TokenOptions": {
        "Audience": "",
        "Issuer": "",
        "SecurityKey": "",
        "AccessTokenExpiration": 15,
        "RefreshTokenExpiration": 7,
        "MaxActiveTokens": 5
    },
    "MailSettings": {
        "Server": "",
        "Port": 0,
        "SenderFullName": "",
        "SenderEmail": "",
        "UserName": "",
        "Password": ""
    },
    "SecuritySettings": {
        "DefaultRoleId": "",
        "AdminRoleId": ""
    },
    "OllamaSettings": {
        "BaseUrl": "http://localhost:11434",
        "ModelName": "llama3:latest",
        "SystemPrompt": "Sen kıdemli bir mutfak ve veri tabanı asistanısın. Kullanıcının girdiği malzeme adını analiz edip SADECE JSON formatında yanıt vermelisin. Asla ekstra açıklama yapma. JSON formatı: {\"IsNew\": bool, \"SuggestedAliasFor\": \"string veya null\", \"Category\": \"string\", \"BaseUnitType\": \"string\", \"Reason\": \"string\"}"
    },
    "CloudinarySettings": {
        "CloudName": "",
        "ApiKey": "",
        "ApiSecret": ""
    },
    "AiService": {
        "BaseUrl": "http://localhost:8000",
        "ApiKey": "oleai_shared_secret_key_for_development"
    }

}
